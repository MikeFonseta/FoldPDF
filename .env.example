# Copy to .env and adjust. System environment variables take precedence over .env.
# The .env file is read from the current directory at startup (native mode).

# Listen address and port (used by `python -m app`; with `uvicorn` pass --host/--port).
# 127.0.0.1 = local only; 0.0.0.0 = all network interfaces.
HOST=127.0.0.1
PORT=8080

# Data directory. The uploads/, results/, profiles/ and work/ subdirectories are created here.
DATA_DIR=./data
# SQLite database (sqlite:///path). Empty = DATA_DIR/jobs.db
DATABASE_URL=sqlite:///./data/jobs.db

# Specific directories (optional, must be distinct). Empty = subdirectories of DATA_DIR.
UPLOAD_DIR=
RESULT_DIR=
PROFILE_DIR=
WORK_DIR=

# LibreOffice executable. Empty = automatic detection (PATH and standard locations).
# Examples:
#   Windows: LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
#   macOS:   LIBREOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
#   Linux:   LIBREOFFICE_BIN=/usr/bin/soffice
LIBREOFFICE_BIN=

# API keys accepted in the X-API-Key header, comma-separated (at least 16 characters each).
# Empty = authentication disabled. Several keys allow rotation without downtime.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Maximum wait allowed for POST /jobs?wait=N (seconds). 0 = single-call mode disabled.
MAX_SYNC_WAIT_SECONDS=30

# Maximum upload size in bytes (25 MiB).
MAX_UPLOAD_BYTES=26214400
# Concurrent conversions (each one is a LibreOffice process: ~200-500 MB of RAM).
MAX_WORKERS=2
# Queued jobs beyond which POST /jobs answers 503.
MAX_QUEUED_JOBS=100
# Maximum attempts for a job interrupted by a restart.
MAX_ATTEMPTS=2
# Timeout of a single conversion, in seconds.
CONVERSION_TIMEOUT_SECONDS=120
# Retention time of finished jobs (and their PDFs), in seconds.
JOB_TTL_SECONDS=3600
# Interval of the periodic cleanup, in seconds.
CLEANUP_INTERVAL_SECONDS=60

# Safety limits for the ZIP packages of the documents.
ZIP_MAX_ENTRIES=10000
ZIP_MAX_UNCOMPRESSED_BYTES=536870912
ZIP_MAX_COMPRESSION_RATIO=200

# CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO
